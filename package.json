{
  "name": "whoop-whoop",
  "version": "1.0.0",
  "description": "Telegram moderation bot with OpenAI integration",
  "main": "dist/index.js",
  "scripts": {
    "setup:env": "node setup-env.mjs",
    "setup:bot": "node setup-bot.mjs",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "npm run build && npm start"
  },
  "keywords": [
    "telegram",
    "bot",
    "moderation",
    "openai",
    "grammy"
  ],
  "author": "imdbv",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@grammyjs/conversations": "^2.1.0",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.1",
    "grammy": "^1.38.1",
    "node-fetch": "^3.3.2",
    "openai": "^5.13.1",
    "pg": "^8.16.3",
    "tesseract.js": "^5.1.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}